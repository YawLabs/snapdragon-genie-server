# venvs
ort2/
onnx-venv/
.venv/
venv/
env/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# generated / downloaded models
*.onnx
*.onnx.data
*.gguf
models/

# coverage. `pytest --cov` writes these, and that flag comes from pytest-cov,
# which is deliberately NOT in requirements-dev.txt -- in the documented dev
# venv it is "unrecognized arguments: --cov" until you `pip install pytest-cov`
# yourself. Ignored anyway, because the repo has no CI to collect them and a
# local run should not leave something for `git add -A` to sweep in.
.coverage
# Per-process data files: tests that start a subprocess under coverage write
# `.coverage.<host>.pid<N>.<random>` beside the main file, and `.coverage`
# alone does not match them.
.coverage.*
htmlcov/

# logs / scratch
*.log
# src/bench_servers.py's default --out, written to the CWD -- so a sweep run
# from the repo root leaves it here, and a `git add -A` would sweep a box's
# raw measurements into the repo. (Its per-arm logs, bench_servers-<arm>.log,
# are covered by *.log above.)
sweep-results.json
# ...and its fallback record, written beside --out as sweep-results.<UTC
# stamp>.json when --out cannot be written or appeared during the sweep.
sweep-results.*.json

# staging for a Hugging Face model release -- deliberately untracked, so a
# `git add -A` cannot sweep an unpublished model card into this repo
/publish/

# Internal decision memo -- untracked before the repo went public.
/docs/OPEN_SOURCE_PLAN.md
